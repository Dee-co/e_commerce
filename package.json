{
  "name": "e_commerce",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "start:dev": "npx react-native start --reset-cache",
    "clean:android": "cd android && ./gradlew clean",
    "android:fresh": "cd android && ./gradlew clean && cd .. && react-native run-android",
    "android:release": "react-native run-android --mode release",
    "clean:watchman": "watchman watch-del-all || true",
    "clean:build": "rm -rf android/build android/app/build",
    "clean:modules": "rm -rf node_modules",
    "reinstall": "npm run clean:modules && npm install",
    "build:release": "cd android && ./gradlew assembleRelease",
    "build:release:fresh": "watchman watch-del-all || true && rm -rf node_modules android/build android/app/build && npm install && cd android && ./gradlew clean && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.13.0",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-picker/picker": "^2.11.4",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@reduxjs/toolkit": "^2.13.0",
    "axios": "^1.20.0",
    "lucide-react-native": "^1.49.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-config": "^1.7.2",
    "react-native-keyboard-controller": "^1.22.6",
    "react-native-otp-entry": "^1.8.6",
    "react-native-reanimated": "^4.7.0",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "^15.15.5",
    "react-native-toast-message": "^2.5.2",
    "react-native-worklets": "^0.13.0",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
